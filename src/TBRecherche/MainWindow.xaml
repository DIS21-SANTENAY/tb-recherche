<Window x:Class="TBRecherche.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TB Recherche" Icon="app.ico" Height="900" Width="1480" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Colonne latérale ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Side}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,16,18">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Accent}">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TB Recherche" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SideInk}"/>
                        <TextBlock Text="Vos mails Thunderbird" FontSize="11.5" Foreground="{StaticResource SideMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Carte d'état de l'index -->
                <Border DockPanel.Dock="Bottom" Margin="14,8,14,14" Padding="14,12" CornerRadius="12" Background="#202228">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse x:Name="IndexDot" Width="7" Height="7" Fill="#3FB37F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Index" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SideMuted}"/>
                        </DockPanel>
                        <TextBlock x:Name="IndexStatus" Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource SideInk}" TextWrapping="Wrap" Text="Chargement..."/>
                        <TextBlock x:Name="IndexDetail" Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource SideMuted}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button x:Name="IndexButton" Style="{StaticResource BtnSide}" Margin="0,0,4,0" Click="Index_Click" ToolTip="Relire les dossiers modifiés">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Actualiser"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RebuildButton" Style="{StaticResource BtnSide}" Margin="4,0,0,0" Click="FullIndex_Click" Content="Reconstruire"
                                    ToolTip="Reconstruire tout l'index"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Comptes" Margin="10,4,0,6" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SideMuted}"/>
                        <ListBox x:Name="AccountList" Style="{StaticResource SideList}" SelectionChanged="Filter_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11.5" Foreground="{StaticResource SideMuted}" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Période" Margin="10,22,0,6" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SideMuted}"/>
                        <ListBox x:Name="PeriodList" Style="{StaticResource SideList}" SelectionChanged="Period_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="CustomDates" Margin="10,6,4,0" Visibility="Collapsed">
                            <TextBlock Text="Du" Foreground="{StaticResource SideMuted}" FontSize="11.5" Margin="0,0,0,3"/>
                            <DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed"/>
                            <TextBlock Text="Au" Foreground="{StaticResource SideMuted}" FontSize="11.5" Margin="0,8,0,3"/>
                            <DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Filtres" Margin="10,22,0,4" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SideMuted}"/>
                        <CheckBox x:Name="AttachOnly" Style="{StaticResource Switch}" Content="Avec pièce jointe" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Zone principale ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête : recherche + boutons de fenêtre -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchShell" Grid.Column="0" Height="40" Margin="16,10,8,6" CornerRadius="11" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" Effect="{StaticResource CardShadow}"
                        WindowChrome.IsHitTestVisibleInChrome="True" MaxWidth="860" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,10,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="15"
                                 VerticalContentAlignment="Center" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown"
                                 GotKeyboardFocus="SearchBox_Focus" LostKeyboardFocus="SearchBox_Focus"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" IsHitTestVisible="False" FontSize="15" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="#ABA59F" Text="Rechercher dans les mails et leurs pièces jointes"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button x:Name="ClearButton" Style="{StaticResource BtnGhost}" Padding="8,4" Click="Clear_Click" Visibility="Collapsed" ToolTip="Effacer (Échap)">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </Button>
                            <Border Background="{StaticResource Hover}" CornerRadius="5" Padding="6,2" Margin="4,0,4,0">
                                <TextBlock Text="Ctrl F" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="HelpButton" Grid.Column="1" Style="{StaticResource BtnGhost}" Margin="0,10,8,6" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Help_Click" ToolTip="Syntaxe de recherche">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Ink2}"/>
                        <TextBlock Text="Astuces" Margin="7,0,0,0" Foreground="{StaticResource Ink2}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" Content="&#xE922;" Click="Max_Click"/>
                    <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>

                <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-330" VerticalOffset="6">
                    <Border Background="{StaticResource Surface}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="20,18" Margin="12" Effect="{StaticResource SoftShadow}" Width="420">
                        <StackPanel>
                            <TextBlock Text="Rechercher efficacement" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Tous les mots sont obligatoires, en début de mot, sans tenir compte des accents ni des majuscules."/>
                            <Grid x:Name="HelpGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Entrée ou double-clic sur un résultat : ouvrir dans Thunderbird. Flèches haut et bas depuis la recherche : parcourir les résultats."/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Corps : liste + lecture -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" MinWidth="330" MaxWidth="700"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- Liste de résultats -->
                <DockPanel Grid.Column="0">
                    <DockPanel DockPanel.Dock="Top" Margin="18,6,8,10">
                        <Border DockPanel.Dock="Right" Background="#ECE9E5" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SortRecent" Style="{StaticResource Segment}" Content="Récents" GroupName="sort" IsChecked="True" Checked="Filter_Changed"/>
                                <RadioButton x:Name="SortRelevance" Style="{StaticResource Segment}" Content="Pertinence" GroupName="sort" Checked="Filter_Changed"/>
                                <RadioButton x:Name="SortOld" Style="{StaticResource Segment}" Content="Anciens" GroupName="sort" Checked="Filter_Changed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ResultCount" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResultInfo" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="SearchProgress" DockPanel.Dock="Top" Height="3" Margin="18,0,14,6" IsIndeterminate="True"
                                 Foreground="{StaticResource Accent}" Background="#ECE9E5" BorderThickness="0" Visibility="Hidden"/>

                    <Grid>
                        <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Padding="10,0,2,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick" PreviewKeyDown="Results_KeyDown"
                                 FocusVisualStyle="{x:Null}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Margin="6,0,6,6">
                                                    <Border x:Name="card" CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1" Padding="14,12,14,11">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,14" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="card" Property="Background" Value="{StaticResource Selected}"/>
                                                        <Setter TargetName="card" Property="BorderBrush" Value="#EBC3CD"/>
                                                        <Setter TargetName="card" Property="Effect" Value="{StaticResource CardShadow}"/>
                                                        <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" VerticalAlignment="Top" Margin="0,1,12,0">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SmartDate}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="8,1,0,0"/>
                                                <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subject}" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Snippet}" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34" LineHeight="17"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="5" Padding="6,1" Margin="6,0,0,0"
                                                            Visibility="{Binding InAttachmentVisibility}">
                                                        <TextBlock Text="dans une PJ" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE723;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding AttachVisibility}"/>
                                                </StackPanel>
                                                <Border CornerRadius="5" Padding="6,1" Background="#F1EFEC" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding AccountBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Account}" FontSize="11" Foreground="{StaticResource Ink2}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding FolderShort}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyResults" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="30">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="#CFC9C2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Aucun message trouvé" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                                       Text="Essayez moins de mots, ou retirez un filtre de la colonne de gauche."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE"/>

                <!-- Volet de lecture -->
                <Border Grid.Column="2" Margin="0,0,16,16" CornerRadius="14" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="ReaderHeader" Margin="28,20,24,0" Visibility="Collapsed">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="RemoteButton" Style="{StaticResource BtnGhost}" Click="Remote_Click" Visibility="Collapsed"
                                            ToolTip="Les images hébergées sur Internet sont bloquées pour éviter le pistage">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Afficher les images" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnBase}" Margin="6,0,0,0" Click="SaveEml_Click" ToolTip="Enregistrer le message (.eml)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Enregistrer" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OpenTb_Click" ToolTip="Ouvrir dans Thunderbird (Entrée)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ouvrir dans Thunderbird" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Padding="8,3" Background="#F1EFEC">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="PvAccountDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="PvAccount" FontSize="12" Foreground="{StaticResource Ink2}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock x:Name="PvFolder" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="PvSubject" Margin="0,18,0,0" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="29"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PvAvatar" Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0">
                                    <TextBlock x:Name="PvInitials" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PvFromName" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PvFromAddr" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="PvDate" Grid.Column="2" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="12,3,0,0"/>
                            </Grid>
                            <TextBlock x:Name="PvTo" Margin="54,8,0,0" FontSize="12.5" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis"/>

                            <ItemsControl x:Name="PvAttachments" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Attachment_Click" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" CornerRadius="10" Background="White" BorderBrush="{Binding RingBrush}" BorderThickness="{Binding Ring}" Padding="6,6,12,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FAF9F7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="36" CornerRadius="6" Background="{Binding BadgeBrush}">
                                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Size}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Text="  ·  contient la recherche" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                                                   Visibility="{Binding MatchVisibility}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{StaticResource Border}" Margin="-28,6,-24,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="22,8,8,8">
                            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" DefaultBackgroundColor="White"/>
                            <RichTextBox x:Name="Fallback" Visibility="Collapsed" IsReadOnly="True" BorderThickness="0" Padding="4"
                                         VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        </Grid>

                        <StackPanel x:Name="ReaderEmpty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#F4F1EE" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="#BDB6AE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sélectionnez un message" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                            <TextBlock x:Name="ReaderEmptyHint" Text="Son contenu s'affichera ici, avec vos mots surlignés." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
